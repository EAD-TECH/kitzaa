Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "title": "Kinderfest im Park",
  "description": "Ein spassiges Kinderfest mit Spielen und Musik.",
  "categoryId": "6a65d605593cc260697d7f53",
  "ageRange": "7-10",
  "isFree": true,
  "schedule": {
    "startDate": "2026-07-31",
    "startTime": "10:00",
    "endTime": "16:00"
  },
  "location": {
    "addressLine": "Parkstrasse 1",
    "city": "Berlin",
    "zipCode": "10115",
    "country": "DE"
  },
  "capacity": { "max": 6 }
}




