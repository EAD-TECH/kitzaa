### ==========================================================
### Kindora / Kitzaa Backend - REST Client requests
### Requires the "REST Client" VS Code extension (humao.rest-client)
### ==========================================================

@baseUrl = http://localhost:8000/api/v1
@contentType = application/json

### ------------------------------------------------------------
### Health check
### ------------------------------------------------------------
GET http://localhost:8000/health


### ------------------------------------------------------------
### AUTH
### ------------------------------------------------------------

### Register
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "username": "duygu",
  "firstName": "duygu",
  "lastName": "cankurt",
  "email": "dyg.cankurt17@gmail.com",
  "password": "Duygu123.",
  "phone": "+491234567890",
  "language": "de",
  "location": {
    "city": "Berlin",
    "zipCode": "10115",
    "country": "DE"
  }
}


### Login
# @name login
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "login": "duygu",
  "password": "Duygu123."
}

### Capture the access token returned by login for use below
@accessToken = {{login.response.body.$.accessToken}}


### Refresh access token (uses the httpOnly refreshToken cookie set by login/register)
POST {{baseUrl}}/auth/refresh


### Logout
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{accessToken}}


### Forgot password
### NOTE: authController.forgotPassword is currently an empty stub (no logic implemented yet)
POST {{baseUrl}}/auth/forgot-password
Content-Type: {{contentType}}

{
  "email": "dyg.cankurt17@gmail.com"
}


###

POST {{baseUrl}}/auth/reset-password/29155b09a8d7642e4900bbc0388d23d56ecf5c5912243e4e5aea02a4d651ee60
Content-Type: {{contentType}}

{
  "newPassword": "Almanca12.",
  "confirmPassword":"Almanca12."
}


### ------------------------------------------------------------
### USERS (all require Authorization: Bearer {{accessToken}})
### ------------------------------------------------------------

### List users (supports query params via queryHandler middleware, e.g. ?page=1&limit=10)
GET {{baseUrl}}/users
Authorization: Bearer {{accessToken}}


### Get single user by id
@userId = REPLACE_WITH_USER_ID
GET {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{accessToken}}


### Update user
PUT {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "firstName": "Johnny",
  "location": {
    "city": "Munich"
  }
}


### Delete user
DELETE {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{accessToken}}


### Update password
PUT {{baseUrl}}/users/{{userId}}/password
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "currentPassword": "Passw0rd!",
  "newPassword": "NewPassw0rd!1",
  "confirmPassword": "NewPassw0rd!1"
}


### ------------------------------------------------------------
### ORGANIZER APPLICATION (requires Authorization)
### ------------------------------------------------------------

### Apply as organizer
POST {{baseUrl}}/organizer-applications
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "institutionData": {
    "name": "Spielhaus Berlin",
    "description": "Kinder und Familien Aktivitäten",
    "address": "Berlin, Germany",
    "phone": "+491234567890",
    "website": "https://spielhaus-berlin.de",
    "category": "Kinder & Familie"
  },
  "message": "Ich organisiere seit 5 Jahren Veranstaltungen für Familien."
}