### ==========================================================
### Kindora / Kitzaa Backend - REST Client requests
### Requires the "REST Client" VS Code extension (humao.rest-client)
### ==========================================================

@baseUrl = http://localhost:8000/api/v1
@contentType = application/json

### ------------------------------------------------------------
### Health check
### ------------------------------------------------------------
GET http://localhost:8000/health


### ------------------------------------------------------------
### AUTH
### ------------------------------------------------------------

### Register
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "username": "nUser",
  "firstName": "nUser",
  "lastName": "ncankurt",
  "email": "musacankurt2@gmail.com",
  "password": "nDuygu123.",
  "phone": "+491234567890",
  "language": "de",
  "location": {
    "city": "Berlin",
    "zipCode": "10115",
    "country": "DE"
  }
}


### Login
# @name login
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "login": "duygu",
  "password": "Duygu123."
}

### Capture the access token returned by login for use below
@accessToken = {{login.response.body.$.accessToken}}


### Refresh access token (uses the httpOnly refreshToken cookie set by login/register)
POST {{baseUrl}}/auth/refresh


### Logout
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{accessToken}}


### Forgot password
### NOTE: authController.forgotPassword is currently an empty stub (no logic implemented yet)
POST {{baseUrl}}/auth/forgot-password
Content-Type: {{contentType}}

{
  "email": "dyg.cankurt17@gmail.com"
}


###

POST {{baseUrl}}/auth/reset-password/29155b09a8d7642e4900bbc0388d23d56ecf5c5912243e4e5aea02a4d651ee60
Content-Type: {{contentType}}

{
  "newPassword": "Almanca12.",
  "confirmPassword":"Almanca12."
}


### ------------------------------------------------------------
### USERS (all require Authorization: Bearer {{accessToken}})
### ------------------------------------------------------------

### List users (supports query params via queryHandler middleware, e.g. ?page=1&limit=10)
GET {{baseUrl}}/users
Authorization: Bearer {{accessToken}}


### Get single user by id
@userId = REPLACE_WITH_USER_ID
GET {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{accessToken}}


### Update user
PUT {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "firstName": "Johnny",
  "location": {
    "city": "Munich"
  }
}


### Delete user
DELETE {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{accessToken}}


### Update password
PUT {{baseUrl}}/users/{{userId}}/password
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "currentPassword": "Passw0rd!",
  "newPassword": "NewPassw0rd!1",
  "confirmPassword": "NewPassw0rd!1"
}


### ------------------------------------------------------------
### EVENT CATEGORIES (user) - list/read only, active categories only
### ------------------------------------------------------------

### List categories (supports query params via queryHandler middleware, e.g. ?page=1&limit=10)
GET {{baseUrl}}/category
Authorization: Bearer {{accessToken}}


### Get single category by id
@categoryId = REPLACE_WITH_CATEGORY_ID
GET {{baseUrl}}/category/{{categoryId}}
Authorization: Bearer {{accessToken}}


### ------------------------------------------------------------
### EVENT CATEGORIES (admin) - full CRUD, requires role: admin
### ------------------------------------------------------------

### Create category
POST {{baseUrl}}/admin/categories
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "name": "Konzerte",
  "description": "Live-Musik-Veranstaltungen",
  "icon": "music",
  "isActive": true
}


### List all categories (active and inactive)
GET {{baseUrl}}/admin/categories
Authorization: Bearer {{accessToken}}


### Get single category by id
GET {{baseUrl}}/admin/categories/{{categoryId}}
Authorization: Bearer {{accessToken}}


### Update category
PUT {{baseUrl}}/admin/categories/{{categoryId}}
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "name": "Konzerte & Festivals",
  "isActive": true
}


### Delete category
DELETE {{baseUrl}}/admin/categories/{{categoryId}}
Authorization: Bearer {{accessToken}}


### ------------------------------------------------------------
### ORGANIZER APPLICATION (requires Authorization)
### ------------------------------------------------------------

### Apply as organizer
POST {{baseUrl}}/organizer-applications
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "institutionData": {
    "name": "Hüpftag Niefern",
    "description": "Kinder Aktivitäten",
    "address": "Niefern, Germany",
    "phone": "+491234567890",
    "website": "https://malhaus-niefern.de",
    "category": "Kinder"
  },
  "message": "Ich organisiere seit 3 Jahren Veranstaltungen für Kinder."
}


### Get my organizer applications
GET {{baseUrl}}/organizer-applications/me
Authorization: Bearer {{accessToken}}


### ------------------------------------------------------------
### INSTITUTION (requires Authorization + role: organizer)
### ------------------------------------------------------------

### Get my institution
GET {{baseUrl}}/institutions/me
Authorization: Bearer {{accessToken}}


### Update my institution
PUT {{baseUrl}}/institutions/me
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Hüpftag Niefern",
  "description": "Aktualisierte Beschreibung",
  "address": "Niefern, Germany",
  "phone": "+491234567890",
  "website": "https://malhaus-niefern.de",
  "category": "Kinder"
}


### ------------------------------------------------------------
### ORGANIZER APPLICATIONS (admin) - requires role: admin
### Login above must be an admin user so {{accessToken}} works here
### ------------------------------------------------------------

### List organizer applications (e.g. ?page=1&limit=10 or ?filter[status]=pending)
GET {{baseUrl}}/admin/organizer-applications
Authorization: Bearer {{accessToken}}


### Get single organizer application by id
@organizerApplicationId = 6a666e09104a80874e01e9dd
GET {{baseUrl}}/admin/organizer-applications/{{organizerApplicationId}}
Authorization: Bearer {{accessToken}}


### Approve organizer application (creates Institution + sets user role to organizer)
PUT {{baseUrl}}/admin/organizer-applications/{{organizerApplicationId}}/approve
Authorization: Bearer {{accessToken}}


### Reject organizer application (rejectedReason required, min 3 chars)
PUT {{baseUrl}}/admin/organizer-applications/{{organizerApplicationId}}/reject
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "rejectedReason": "Unterlagen unvollständig"
}
